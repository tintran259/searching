# Sao chép thành .env.local rồi điền giá trị: cp .env.example .env.local

# Bắt buộc: API key SerpApi — https://serpapi.com/manage-api-key
SERPAPI_KEY=

# Dịch từ khoá sang ngôn ngữ khác — cần cho phạm vi Ngoài nước (chỉ cần MỘT bộ dịch chính)
# - Gemini: có gói miễn phí — tạo key tại https://aistudio.google.com/apikey
#   (gói miễn phí: Google dùng nội dung gửi lên để cải thiện sản phẩm)
GEMINI_API_KEY=
# - Claude: trả theo lượng dùng — https://console.anthropic.com/
ANTHROPIC_API_KEY=
# - Microsoft Azure Translator (gói F0 miễn phí ~2 triệu ký tự/tháng): bộ DỰ PHÒNG khi Gemini / Claude lỗi
#   hoặc hết lượt (dịch máy, chỉ 1 cách viết). Tạo tài nguyên "Translator" trên Azure, lấy Key và Location/Region.
AZURE_TRANSLATOR_KEY=
# AZURE_TRANSLATOR_REGION=southeastasia   # bắt buộc nếu tài nguyên không phải "Global"

# --- Tuỳ chọn ---
# TRANSLATOR=gemini                  # gemini | claude | microsoft | off — mặc định tự chọn theo key (Gemini, Claude, Microsoft)
# GEMINI_MODEL=gemini-3.8-flash      # vd gemini-3.5-flash-lite (nhanh hơn)
# SEARCH_PROVIDER=serpapi            # nhà cung cấp tìm kiếm
# CACHE_MODE=file                    # file | memory | off
# CACHE_DIR=./.cache                 # thư mục cache (khi CACHE_MODE=file)
# FETCH_USER_AGENT=Mozilla/5.0 (compatible; ArticleFinderBot/0.1)
